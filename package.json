{
  "name": "my-drama-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "End-to-end test suite for the My Drama mobile web app",
  "scripts": {
    "test": "playwright test",
    "test:chrome": "playwright test --project=mobile-chrome",
    "test:safari": "playwright test --project=mobile-safari",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
